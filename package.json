{
  "name": "xfield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @xfield/web",
    "build": "npm run build -w @xfield/web",
    "start": "npm run start -w @xfield/web",
    "db:generate": "npm run generate -w @xfield/db",
    "db:migrate": "npm run migrate -w @xfield/db",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint apps packages tests scripts",
    "format": "prettier --write apps packages tests scripts/capture.mjs",
    "format:check": "prettier --check apps packages tests scripts/capture.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
