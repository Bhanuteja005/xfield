# Leave everything empty for local development: the API then uses an embedded
# Postgres database and local file storage under apps/web/.data/.

# Supabase Postgres, "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Supabase Storage. The service role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
